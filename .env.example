# Copy this file to `.env` and fill in the values from your Entra app registration.

# Application (client) ID from Entra > App registrations > Overview
CLIENT_ID=00000000-0000-0000-0000-000000000000

# Directory (tenant) ID from Entra > App registrations > Overview
TENANT_ID=00000000-0000-0000-0000-000000000000

# Random secret used to sign Flask session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-string

# URL new guests are sent to after accepting the invitation.
INVITE_REDIRECT_URL=https://myapps.microsoft.com

# Local port the Flask app listens on. Must match the redirect URI registered
# in Entra: http://localhost:<PORT>/auth/callback
PORT=5000
