# Everything here is OPTIONAL. With no .env at all, the app signs in via
# Microsoft's pre-consented Azure CLI public client: no app registration,
# no admin consent. Access is whatever the signed-in user's Entra roles allow.

# --- Optional: use your own Entra app registration instead ---
# Requires registering http://localhost:<PORT> (root path) as a
# "Mobile and desktop applications" redirect URI, and the delegated
# Directory.AccessAsUser.All permission (which DOES need admin consent).
#CLIENT_ID=00000000-0000-0000-0000-000000000000

# Pin sign-in to a single tenant (default: "organizations" = any work account)
#TENANT_ID=00000000-0000-0000-0000-000000000000

# Persistent session-cookie key. If unset, a random one is generated per run
# (you just re-sign-in after restarting the app). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#FLASK_SECRET_KEY=

# URL new invitees are sent to after accepting the invitation.
#INVITE_REDIRECT_URL=https://myapps.microsoft.com

# Local port the app listens on.
#PORT=5000
